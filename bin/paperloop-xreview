#!/usr/bin/env python3
"""Cross-family review: send a paper to NON-Claude models through OpenRouter, so a Claude-written
paper is not judged only by Claude. Defaults to FREE models; paid models need --allow-paid and a
--max-usd cap. The API key is read from $OPENROUTER_API_KEY or from --env-file and never printed.

Usage:
  paperloop-xreview models                                   list free models with context length
  paperloop-xreview review PAPER(.pdf|.tex) --out DIR --venue V --field F --scale S [--models a,b]
  paperloop-xreview judge  X(.pdf|.tex) Y(.pdf|.tex) --out DIR --field F [--models a,b] [--diff-only]
  paperloop-xreview aiprose PAPER(.tex|.pdf) --out DIR --field F [--models a,b]   machine-prose judge, one call per section
Common: --env-file PATH  --allow-paid  --max-usd 0.50  --dry-run (build prompts, call nothing)

review writes DIR/<model>.md (same brief as agents/blind-reviewer.md).
judge  writes DIR/<model>.json ({"winner": "X|Y|tie", ...}); call twice with X/Y swapped.
       --diff-only sends only the paragraphs that differ (plus one paragraph of context), which keeps
       free models inside their limits; whole-paper judging of a long paper often times out.
aiprose writes DIR/<model>.json: per-section scores from agents/ai-prose-judge.md, merged.
"""
import argparse, json, os, re, shutil, subprocess, sys, time, urllib.error, urllib.request

API = "https://openrouter.ai/api/v1"
DEFAULT_MODELS = ["poolside/laguna-s-2.1:free", "nvidia/nemotron-3-super-120b-a12b:free"]   # free tiers change often; see `paperloop-xreview models`
HERE = os.path.dirname(os.path.abspath(__file__))


def key_from(env_file):
    k = os.environ.get("OPENROUTER_API_KEY")
    if not k and env_file:
        for line in open(env_file):
            m = re.match(r"\s*(?:export\s+)?OPENROUTER_API_KEY\s*=\s*['\"]?([^'\"\s]+)", line)
            if m:
                k = m.group(1)
    if not k:
        sys.exit("no OpenRouter key: set OPENROUTER_API_KEY or pass --env-file (the key is never printed)")
    return k


def get(path, key=None):
    req = urllib.request.Request(API + path, headers={"Authorization": f"Bearer {key}"} if key else {})
    return json.load(urllib.request.urlopen(req, timeout=60))


def catalog():
    return {m["id"]: m for m in get("/models")["data"]}


def is_free(m):
    p = m.get("pricing", {})
    return m["id"].endswith(":free") or (float(p.get("prompt", 1) or 0) == 0 and float(p.get("completion", 1) or 0) == 0)


def paper_text(path):
    if path.endswith(".pdf"):
        if not shutil.which("pdftotext"):
            sys.exit("pdftotext not found (poppler-utils); pass the .tex instead")
        return subprocess.run(["pdftotext", "-layout", path, "-"], capture_output=True, text=True, check=True).stdout
    src = open(path, encoding="utf-8", errors="replace").read()
    base = os.path.dirname(os.path.abspath(path))
    src = re.sub(r"\\(?:input|include)\{([^}]+)\}", lambda m: open(os.path.join(base, m.group(1) if m.group(1).endswith(".tex") else m.group(1) + ".tex"), errors="replace").read() if os.path.exists(os.path.join(base, m.group(1) if m.group(1).endswith(".tex") else m.group(1) + ".tex")) else "", src)
    return re.sub(r"(?<!\\)%.*", "", src)


def paragraphs(text):
    return [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]


def diff_only(x, y, context=1):
    """Return (x_excerpt, y_excerpt) holding only the paragraphs that differ, with context."""
    import difflib
    px, py = paragraphs(x), paragraphs(y)
    sm = difflib.SequenceMatcher(a=px, b=py, autojunk=False)
    xs, ys = [], []
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            continue
        xs.append("\n\n".join(px[max(0, i1 - context): i2 + context]))
        ys.append("\n\n".join(py[max(0, j1 - context): j2 + context]))
    sep = "\n\n[...]\n\n"
    return sep.join(xs) or "(no change)", sep.join(ys) or "(no change)"


def sections(text):
    parts = re.split(r"(\\section\*?\{[^}]*\})", text)
    out, head = [], "front matter and abstract"
    for part in parts:
        m = re.match(r"\\section\*?\{([^}]*)\}", part)
        if m:
            head = m.group(1)
        elif part.strip():
            out.append((head, part))
    return out


def brief(name, **kw):
    body = open(os.path.join(HERE, "..", "agents", name + ".md")).read().split("---", 2)[2]
    for k, v in kw.items():
        body = body.replace("{" + k + "}", v)
    return body


def chat(key, model, system, user, max_tokens=6000, tries=2):
    data = json.dumps({"model": model, "messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
                       "max_tokens": max_tokens, "temperature": 0.2, "usage": {"include": True}}).encode()
    for i in range(tries):
        req = urllib.request.Request(API + "/chat/completions", data=data, headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"})
        try:
            r = json.load(urllib.request.urlopen(req, timeout=420))
            if "choices" in r:
                return r["choices"][0]["message"].get("content") or "", r.get("usage", {})
            err = r.get("error", r)
        except urllib.error.HTTPError as e:
            err = f"HTTP {e.code}: {e.read()[:300]!r}"
            if e.code not in (429, 500, 502, 503):
                break
        except (urllib.error.URLError, TimeoutError) as e:
            err = str(e)
        time.sleep(15 * (i + 1))
    raise RuntimeError(f"{model}: {err}")


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["models", "review", "judge", "aiprose"])
    ap.add_argument("files", nargs="*")
    ap.add_argument("--out")
    ap.add_argument("--venue", default="a peer-reviewed machine-learning venue")
    ap.add_argument("--field", default="machine learning")
    ap.add_argument("--scale", default="1-10 (NeurIPS: 3 reject, 4 borderline reject, 5 borderline accept, 6 weak accept, 7 accept, 8 strong accept)")
    ap.add_argument("--models", default=",".join(DEFAULT_MODELS))
    ap.add_argument("--env-file")
    ap.add_argument("--allow-paid", action="store_true")
    ap.add_argument("--max-usd", type=float, default=0.0)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--diff-only", action="store_true")
    a = ap.parse_args(argv)

    if a.cmd == "models":
        for m in sorted((m for m in catalog().values() if is_free(m)), key=lambda m: -(m.get("context_length") or 0)):
            print(m["id"], m.get("context_length"))
        return 0
    need = 2 if a.cmd == "judge" else 1
    if len(a.files) != need or not a.out:
        ap.error(f"{a.cmd} needs {need} file(s) and --out")
    models = [m.strip() for m in a.models.split(",") if m.strip()]

    jobs = None
    if a.cmd == "aiprose":
        system = brief("ai-prose-judge", FIELD=a.field)
        secs = [(h, t) for h, t in sections(paper_text(a.files[0])) if len(t.split()) > 40]
        jobs = [(h, f"Section: {h}\n\n{t}\n\nJudge only this section. Return ONLY the JSON object.") for h, t in secs]
        user = "\n".join(u for _, u in jobs)
    elif a.cmd == "review":
        system = brief("blind-reviewer", VENUE=a.venue, FIELD=a.field, SCALE=a.scale).replace(
            "write one Markdown file at the path you are given", "reply with the review in Markdown")
        user = "The paper (extracted text follows). Write the review.\n\n" + paper_text(a.files[0])
    else:
        system = brief("judge", FIELD=a.field)
        x, y = paper_text(a.files[0]), paper_text(a.files[1])
        if a.diff_only:
            x, y = diff_only(x, y)
            system += "\nYou see only the passages where the two versions differ, with a little context; judge those."
        user = f"=== VERSION X ===\n{x}\n\n=== VERSION Y ===\n{y}\n\nReturn ONLY the JSON object."
    os.makedirs(a.out, exist_ok=True)
    if a.dry_run:
        open(os.path.join(a.out, "prompt.txt"), "w").write(system + "\n\n-----\n\n" + user)
        print(f"dry run: prompt written ({len(system) + len(user)} chars), models {models}")
        return 0

    key = key_from(a.env_file)
    cat = catalog()
    for m in models:
        if m not in cat:
            sys.exit(f"unknown model {m}; run `paperloop-xreview models`")
        if not is_free(cat[m]) and not (a.allow_paid and a.max_usd > 0):
            sys.exit(f"{m} is paid; refusing without --allow-paid and --max-usd")
    spent, failed = 0.0, []
    for m in models:
        ctx = cat[m].get("context_length") or 0
        if a.cmd != "aiprose" and ctx and (len(system) + len(user)) / 3.5 > ctx * 0.9:
            failed.append(f"{m}: paper too long for context {ctx}")
            continue
        safe = m.replace("/", "__").replace(":", "_")
        if a.cmd == "aiprose":
            merged, errs = {"model": m, "sections": [], "passages": [], "patterns": []}, []
            for h, u in jobs:
                try:
                    t, usage = chat(key, m, system, u, max_tokens=3000)
                    spent += float(usage.get("cost") or 0)
                    j = re.search(r"\{.*\}", t, re.S)
                    o = json.loads(j.group(0)) if j else {}
                    merged["sections"].append({"section": h, "score": o.get("overall"), "verdict": o.get("verdict")})
                    merged["passages"] += [{**p, "section": h} for p in o.get("passages", [])]
                    merged["patterns"] += o.get("patterns", [])
                except (RuntimeError, json.JSONDecodeError) as e:
                    errs.append(f"{h}: {e}")
            sc = [s["score"] for s in merged["sections"] if isinstance(s["score"], (int, float))]
            merged["overall"] = round(sum(sc) / len(sc), 2) if sc else None
            merged["errors"] = errs
            json.dump(merged, open(os.path.join(a.out, safe + ".json"), "w"), indent=1)
            print(f"ok {m}: {len(sc)}/{len(jobs)} sections scored, mean {merged['overall']}")
            if not sc:
                failed.append(f"{m}: no section scored")
            continue
        try:
            text, usage = chat(key, m, system, user)
        except RuntimeError as e:
            failed.append(str(e))
            continue
        spent += float(usage.get("cost") or 0)
        if a.cmd == "judge":
            j = re.search(r"\{.*\}", text, re.S)
            try:
                obj = json.loads(j.group(0)) if j else {"winner": "unparsed", "raw": text}
            except json.JSONDecodeError:
                obj = {"winner": "unparsed", "raw": text}
            obj["model"] = m
            json.dump(obj, open(os.path.join(a.out, safe + ".json"), "w"), indent=1)
        else:
            open(os.path.join(a.out, safe + ".md"), "w").write(f"<!-- model: {m} -->\n" + text)
        print(f"ok {m} (cost ${float(usage.get('cost') or 0):.4f})")
        if a.max_usd and spent > a.max_usd:
            print(f"stopping: spent ${spent:.4f} > cap ${a.max_usd}")
            break
    for f in failed:
        print("FAILED", f)
    print(f"total cost ${spent:.4f}")
    return 0 if len(failed) < len(models) else 1


if __name__ == "__main__":
    sys.exit(main())
